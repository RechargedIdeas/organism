[Unit]
Description=Organism substrate (CPU-only single-device)
After=network.target

[Service]
Type=simple
User=organism
Group=organism
WorkingDirectory=/opt/organism
Environment=ORGANISM_CONFIG=/etc/organism/cpu_only.yaml
Environment=ORGANISM_PREFER_GPU=0
Environment=ORGANISM_BIO_GPU_TWIN=0
Environment=ORGANISM_NEURO_SIM=0
Environment=ORGANISM_WETLAB_GPIO=0
Environment=ORGANISM_HEALTH_HOST=127.0.0.1
Environment=ORGANISM_HEALTH_PORT=8787
Environment=PYTHONPATH=/opt/organism/sdk/python:/opt/organism/modules:/opt/organism
ExecStart=/opt/organism/.venv/bin/python -m organism_sdk serve --config /etc/organism/cpu_only.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
