# Copy to cpu_only.env and source, or pass via Docker --env-file.
ORGANISM_PROFILE=cpu_only
ORGANISM_CONFIG=/etc/organism/cpu_only.yaml
ORGANISM_PREFER_GPU=0
ORGANISM_BIO_GPU_TWIN=0
ORGANISM_BIO_DIGITAL_SIM=1
ORGANISM_NEURO_SIM=0
ORGANISM_NEURO_HW=0
ORGANISM_WETLAB_GPIO=0
# Optional Hybrid checkout (not required for CPU-only):
# BIO_DIGITAL_HYBRID_ROOT=/opt/Bio-Digital_Hybrid_Cluster
ORGANISM_HEALTH_HOST=127.0.0.1
ORGANISM_HEALTH_PORT=8787
PYTHONPATH=sdk/python:modules:.
